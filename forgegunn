-- =================================================================
-- 1. INFINITE AMMO BYPASS (MEMORY HOOK)
-- =================================================================
task.spawn(function()
    while task.wait(0.2) do
        if infiniteAmmoEnabled then
            pcall(function()
                for _, v in pairs(getgc(true)) do
                    if type(v) == "function" then
                        local env = getfenv(v)
                        if env and env.script and env.script.Name == "AmmoController" then
                            for i = 1, 10 do
                                local succ, val = pcall(debug.getupvalue, v, i)
                                if succ and type(val) == "number" then
                                    if val > 0 and val <= 200 then
                                        debug.setupvalue(v, i, customMagazineSize)
                                    end
                                end
                            end
                        end
                    end
                end
                
                local char = localPlayer.Character
                if char then
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") then
                            tool:SetAttribute("Ammo", customMagazineSize)
                            tool:SetAttribute("Reloading", false)
                        end
                    end
                end
            end)
        end
    end
end)

-- =================================================================
-- 2. HOOK SETTINGS AUTO-AIM BAWAAN GAME (SUPAYA IKUT LOCKING ASLI)
-- =================================================================
task.spawn(function()
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" and rawget(v, "Set") and rawget(v, "Setting") then
                -- Memaksa setting AutoAim internal game menjadi true agar fitur bawaan game aktif terus
                v.Set("AutoAim", true)
            end
        end
    end)
end)

-- =================================================================
-- 3. PENCARIAN MUSUH TERDEKAT (UNTUK AUTO-FARM TELEPORT)
-- =================================================================
local function GetClosestTargetModel()
    local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
    if not enemyFolder then return nil end
    
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPos = char.HumanoidRootPart.Position
    
    local closestModel = nil
    local shortestDist = math.huge
    
    for _, enemyModel in ipairs(enemyFolder:GetChildren()) do
        if enemyModel:IsA("Model") then
            local enemyId = enemyModel:GetAttribute("EnemyId")
            local hp = tonumber(enemyModel:GetAttribute("Hp")) or 0
            
            if enemyId and hp > 0 then
                local primaryPart = enemyModel:FindFirstChild("HumanoidRootPart") or enemyModel.PrimaryPart
                if primaryPart then
                    local dist = (primaryPart.Position - rootPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestModel = enemyModel
                    end
                end
            end
        end
    end
    return closestModel
end

-- =================================================================
-- 4. AUTO-FARM TELEPORT & NATIVE AIM SYNC
-- =================================================================
RunService.RenderStepped:Connect(function(dt)
    pcall(function()
        local char = localPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        
        -- Loop WalkSpeed & Physics Mod
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if walkSpeedEnabled then
                humanoid.WalkSpeed = customWalkSpeed
            end
            if hipHeightEnabled then
                humanoid.HipHeight = customHipHeight
            end
        end

        -- Auto-Farm Logic & Native Fire Synchronization
        if autoFarmEnabled then
            local targetModel = GetClosestTargetModel()
            if targetModel then
                local tPart = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
                if tPart then
                    local targetCFrame = tPart.CFrame
                    local desiredCFrame = targetCFrame
                    
                    -- Posisi Farm
                    if farmMode == "Behind" then
                        desiredCFrame = targetCFrame * CFrame.new(0, 0, farmDistance)
                    elseif farmMode == "Above" then
                        desiredCFrame = targetCFrame * CFrame.new(0, farmDistance, 0)
                    elseif farmMode == "Under" then
                        desiredCFrame = targetCFrame * CFrame.new(0, -farmDistance, 0)
                    elseif farmMode == "Orbit" then
                        currentOrbitAngle = currentOrbitAngle + (orbitSpeed * dt)
                        local x = math.cos(currentOrbitAngle) * farmDistance
                        local z = math.sin(currentOrbitAngle) * farmDistance
                        desiredCFrame = targetCFrame * CFrame.new(x, 2, z)
                    end
                    
                    -- Teleport mulus ke dekat musuh agar sistem AimAssist bawaan game mendeteksinya di dalam range
                    hrp.CFrame = CFrame.new(desiredCFrame.Position, targetCFrame.Position)
                    
                    -- Jika Native Aim Hook diaktifkan, tembak menggunakan ID asli musuh
                    if nativeAimHookEnabled then
                        local enemyId = targetModel:GetAttribute("EnemyId")
                        if enemyId then
                            requestFireEvent:FireServer(enemyId, tPart.CFrame, damageMultiplier)
                        end
                    end
                end
            end
        end
    end)
end)

